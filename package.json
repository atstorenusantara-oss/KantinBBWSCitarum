{
  "name": "gcoffee-pos-v2",
  "version": "1.0.0",
  "description": "Sistem Kasir Kedai Kopi Terintegrasi Stok Bahan Baku",
  "main": "src/app.js",
  "bin": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "build:bytecode": "npx -p node@18.5.0 bytenode --compile src/services/license.service.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/gcoffee-pos.exe"
  },
  "pkg": {
    "assets": [
      "src/**/*.jsc",
      "public/**/*",
      "legacy_tools/**/*"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "joi": "^17.12.1",
    "multer": "^2.1.1",
    "mysql2": "^3.9.1",
    "node-thermal-printer": "^4.6.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "bytenode": "^1.5.7",
    "nodemon": "^3.0.3",
    "pkg": "^5.8.1"
  }
}
